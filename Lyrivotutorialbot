import os
import logging

from telegram import (
    Update,
    InlineKeyboardButton,
    InlineKeyboardMarkup,
)

from telegram.ext import (
    ApplicationBuilder,
    CommandHandler,
    MessageHandler,
    CallbackQueryHandler,
    filters,
    ContextTypes,
)


# =========================================================
# CONFIGURATION
# =========================================================

BOT_TOKEN = os.environ.get("BOT_TOKEN")
ADMIN_CHAT_ID = 8616559205


# =========================================================
# LOGGING
# =========================================================

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)

logger = logging.getLogger(__name__)


# =========================================================
# CHECK BOT TOKEN
# =========================================================

if not BOT_TOKEN:
    raise RuntimeError(
        "BOT_TOKEN environment variable is not set. "
        "Please add BOT_TOKEN in Wispbyte Environment Variables."
    )


# =========================================================
# PRODUCTS
# =========================================================

PRODUCTS = {
    "p1": {
        "name": "3D Card Lyrics Edit Tutorial",
        "type": "video",
        "file_id": "BAACAgQAAxkBAAEi7utquMpEdmT3t9ONfy7Z7AO04LsrvgACYSEAAq0VyFF9ccA4B4tRmT0E",
    },

    "p2": {
        "name": "Text Animation Lyrics Edit Tutorial",
        "type": "video",
        "file_id": "BAACAgQAAxkBAAEi7uxquMpEMf1EROWbSWYJjolZYUwa6QACZiEAAq0VyFFbTbSlsYN2Yj0E",
    },

    "p3": {
        "name": "Text Animation Lyrics Edit XML",
        "type": "document",
        "file_id": "BQACAgQAAxkBAAEi7kxquKiRJZq5mHe4CsUswcjrRI0JWgAC6RsAAq0VwFFEK9YKYq-Q8j0E",
    },

    "p4": {
        "name": "3D Card Lyrics Edit XML",
        "type": "document",
